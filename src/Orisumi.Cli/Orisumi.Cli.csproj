<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Orisumi.Cli</RootNamespace>
    <AssemblyName>orisumi-cli</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="../Orisumi.Raw/Orisumi.Raw.csproj" />
    <ProjectReference Include="../Orisumi.Capturing/Orisumi.Capturing.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="orisumi-browser-host" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Orisumi.Browser/manifest.json;../Orisumi.Browser/worker.js;../Orisumi.Browser/delivery.js;../Orisumi.Browser/persistent.js"
             Link="Browser/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
