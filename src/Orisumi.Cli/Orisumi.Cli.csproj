<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Orisumi</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>orisumi</ToolCommandName>
    <PackageId>Orisumi.Cli</PackageId>
    <Version>0.1.1</Version>
    <Description>Run Orisumi commands from the current source checkout.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Collectors/*/*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <InternalsVisibleTo Include="CaptureStartupChecks" />
    <InternalsVisibleTo Include="CaptureCoverageChecks" />
    <InternalsVisibleTo Include="SchemaChecks" />
  </ItemGroup>
</Project>
