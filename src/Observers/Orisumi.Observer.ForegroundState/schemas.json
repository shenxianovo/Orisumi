[
  {
    "schemaId": "019e1bbb-ec00-7000-8000-000000000001",
    "content": {
      "displayName": "前台应用时段",
      "description": "表达某个本机应用连续处于前台的一段活动，每段活动一份 Observation；内容保存应用引用与时段开始时读到的名称和图标，事实时间是这一段的时段。",
      "resourceName": "foreground-application-periods",
      "fields": {
        "name": {
          "type": "string",
          "description": "当时读到的应用名称，没读到时为 null",
          "nullable": true,
          "required": true
        },
        "icon": {
          "type": "binary",
          "description": "时段开始时读到的应用图标，1024×1024 像素的 PNG；没读到时为 null",
          "nullable": true,
          "required": true
        },
        "localApplicationId": {
          "type": "reference",
          "description": "观测设备上的本机应用",
          "nullable": false,
          "required": true,
          "target": "thing",
          "role": "part"
        }
      }
    }
  },
  {
    "schemaId": "019e1bbb-ec00-7000-8000-000000000014",
    "content": {
      "displayName": "本机应用描述",
      "description": "说明一个本机应用所在的设备和它的标识线索。事实时间未知。",
      "resourceName": "local-application-descriptions",
      "fields": {
        "localApplicationId": {
          "type": "reference",
          "description": "被描述的本机应用",
          "required": true,
          "nullable": false,
          "target": "thing",
          "role": "about"
        },
        "deviceId": {
          "type": "reference",
          "description": "应用所在的设备",
          "required": true,
          "nullable": false,
          "target": "thing",
          "role": "mention"
        },
        "identifierIds": {
          "type": "array",
          "description": "跨设备线索，顺序无意义；没有时为 []",
          "required": true,
          "nullable": false,
          "items": {
            "type": "reference",
            "description": "一条应用线索",
            "nullable": false,
            "target": "thing",
            "role": "mention"
          }
        },
        "executablePath": {
          "type": "string",
          "description": "可执行文件路径，读不到时为 null",
          "required": true,
          "nullable": true
        }
      },
      "stateFields": [
        "localApplicationId"
      ]
    }
  }
]
