<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>orisumi-dev</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>orisumi-dev</ToolCommandName>
    <PackageId>Orisumi.Dev</PackageId>
    <Version>0.1.0</Version>
    <Description>Develop and deploy Orisumi from a source checkout.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Orisumi.Platform/Orisumi.Platform.csproj" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <InternalsVisibleTo Include="InstanceChecks" />
  </ItemGroup>
</Project>
