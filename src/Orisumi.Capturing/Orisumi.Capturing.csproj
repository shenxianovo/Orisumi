<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <ProjectReference Include="../Orisumi.Raw/Orisumi.Raw.csproj" />
    <InternalsVisibleTo Include="Orisumi.Capturing.Tests" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ForegroundHelper>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/native/orisumi-foreground</ForegroundHelper>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="$(ForegroundHelper)" Link="orisumi-foreground" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildForegroundHelper" BeforeTargets="GetCopyToOutputDirectoryItems;CoreCompile" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="$(MSBuildProjectDirectory)/Native/Foreground.swift" Outputs="$(ForegroundHelper)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ForegroundHelper)'))" />
    <Exec Command="xcrun swiftc -warnings-as-errors -O &quot;$(MSBuildProjectDirectory)/Native/Foreground.swift&quot; -o &quot;$(ForegroundHelper)&quot;" />
  </Target>
</Project>
