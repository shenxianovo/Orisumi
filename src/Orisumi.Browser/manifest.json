{
  "manifest_version": 3,
  "name": "Orisumi 浏览器观测",
  "version": "0.1.0",
  "description": "原样留下标签、窗口、历史、书签与下载记录，保存后移除本机暂存。",
  "minimum_chrome_version": "130",
  "permissions": [
    "tabs",
    "history",
    "bookmarks",
    "downloads",
    "nativeMessaging",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "key": ""
}
