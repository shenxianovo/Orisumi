<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>orisumi-$(MSBuildProjectName.Replace('Orisumi.Collectors.', '').ToLowerInvariant())</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>$(AssemblyName)</ToolCommandName>
    <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Skip dsymutil: the SDK native archives reference unavailable Swift module files. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <!-- Store paths and host identity come from the platform layer. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Orisumi.Platform/Orisumi.Platform.csproj" />
  </ItemGroup>

  <!-- Storage/Schema holds the tables every source database has. -->
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <Compile Include="$(MSBuildThisFileDirectory)Hosting/*.cs" LinkBase="Hosting" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <EmbeddedResource Include="Schema/*/*.sql;$(MSBuildThisFileDirectory)Storage/Schema/*/*.sql"
                      LogicalName="$(AssemblyName).Schema.$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)')))).%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Storage/*.cs" LinkBase="Storage" />
  </ItemGroup>
</Project>
