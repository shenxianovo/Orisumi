<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Store paths and host identity come from the platform layer. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Orisumi.Platform/Orisumi.Platform.csproj" />
  </ItemGroup>

  <!-- Storage/Schema holds the tables every source database has. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <EmbeddedResource Include="Schema/*/*.sql;$(MSBuildThisFileDirectory)Storage/Schema/*/*.sql"
                      LogicalName="$(AssemblyName).Schema.$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)')))).%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)Storage/*.cs" LinkBase="Storage" />
  </ItemGroup>
</Project>
