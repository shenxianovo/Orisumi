{
  "name": "orisumi-chrome-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('../ChromeExtension', {recursive:true, force:true})\" && tsc && node -e \"require('node:fs').copyFileSync('manifest.json', '../ChromeExtension/manifest.json')\"",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "fake-indexeddb": "6.2.8",
    "typescript": "7.0.2"
  }
}
