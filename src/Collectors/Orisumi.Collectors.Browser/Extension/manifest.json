{
  "manifest_version": 3,
  "name": "Orisumi Chrome Collector",
  "version": "0.7.0",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["alarms", "bookmarks", "downloads", "history", "storage", "tabs", "unlimitedStorage"],
  "background": { "service_worker": "worker.js", "type": "module" }
}
