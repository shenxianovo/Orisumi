<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schema/*/*.sql"
                      LogicalName="$(AssemblyName).Schema.$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)')))).%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schema/Version.txt" LogicalName="$(AssemblyName).Schema.Version.txt" />
    <Compile Include="../Storage/SqliteSchema.cs" Link="Storage/SqliteSchema.cs" />
    <Compile Include="../Storage/SqliteFile.cs" Link="Storage/SqliteFile.cs" />
    <Compile Include="../Storage/AppendOnlyFile.cs" Link="Storage/AppendOnlyFile.cs" />
  </ItemGroup>
</Project>
