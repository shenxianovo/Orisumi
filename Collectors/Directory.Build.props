<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>orisumi-$(MSBuildProjectName.Replace('Orisumi.Collectors.', '').ToLowerInvariant())</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>$(AssemblyName)</ToolCommandName>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Skip dsymutil: the SDK native archives reference unavailable Swift module files. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <!-- Shared capture code; the source's own tables, indexes and views are embedded from its Schema/. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Shared/Capture/Orisumi.Capture.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Shared/Platform/Orisumi.Platform.csproj" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <EmbeddedResource Include="Schema/*/*.sql"
                      LogicalName="Schema.$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)')))).%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
