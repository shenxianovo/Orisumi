<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <Target Name="CheckMacOSCollectorTarget" BeforeTargets="PrepareForBuild" Condition="'$(OrisumiPlatform)' != 'MacOS'">
    <Error Text="The macOS collector requires the osx-arm64 target." />
  </Target>

  <ItemGroup Condition="'$(OrisumiPlatform)' == 'MacOS' and $([MSBuild]::IsOSPlatform('OSX'))">
    <MacOSForegroundSource Include="Native/*.swift" />
  </ItemGroup>

  <Target Name="CompileMacOSForeground" Condition="'@(MacOSForegroundSource)' != ''"
          Inputs="@(MacOSForegroundSource);$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)orisumi-macos-foreground">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="xcrun swiftc @(MacOSForegroundSource->'&quot;%(FullPath)&quot;', ' ') -o &quot;$(IntermediateOutputPath)orisumi-macos-foreground&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)orisumi-macos-foreground" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeMacOSForeground" BeforeTargets="AssignTargetPaths" DependsOnTargets="CompileMacOSForeground"
          Condition="'@(MacOSForegroundSource)' != ''">
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)orisumi-macos-foreground"
               Link="orisumi-macos-foreground"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
